# Server only. Never expose these values through client bundles or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTOMATION_WORKER_SECRET=
# Explicit mock selection is allowed only outside NODE_ENV=production.
WHATSAPP_PROVIDER=mock
NODE_ENV=development
# Base64-encoded 32-byte key. Preserve this key to decrypt persisted credentials.
ACCOUNTING_TOKEN_ENCRYPTION_KEY=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REGION=in
ZOHO_BOOKS_REDIRECT_URI=https://YOUR_HOST/api/accounting?provider=zoho_books
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=true
QUICKBOOKS_REDIRECT_URI=https://YOUR_HOST/api/accounting?provider=quickbooks
