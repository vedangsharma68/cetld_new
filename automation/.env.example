# Server only. Never expose these values through client bundles or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTOMATION_WORKER_SECRET=
# Outbound reminders are disabled unless explicitly set to true on the server.
AUTOMATION_OUTBOUND_ENABLED=false
# Explicit mock selection is allowed only outside NODE_ENV=production.
WHATSAPP_PROVIDER=mock
NODE_ENV=development
# Base64-encoded 32-byte key. Preserve this key to decrypt persisted credentials.
ACCOUNTING_TOKEN_ENCRYPTION_KEY=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REGION=in
# Register the exact HTTPS callback paths below. Do not add query parameters.
ZOHO_BOOKS_REDIRECT_URI=https://YOUR_HOST/api/integrations/zoho/callback
QUICKBOOKS_SANDBOX=true
QUICKBOOKS_SANDBOX_CLIENT_ID=
QUICKBOOKS_SANDBOX_CLIENT_SECRET=
# Leave production values unset during sandbox review.
QUICKBOOKS_PRODUCTION_CLIENT_ID=
QUICKBOOKS_PRODUCTION_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://YOUR_HOST/api/integrations/quickbooks/callback
