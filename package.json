{
  "name": "cetld-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests/migration scripts/migration --max-warnings=0",
    "format": "prettier --write src tests/migration",
    "typecheck": "tsc --noEmit && npm run typecheck:legacy",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.migration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit pull",
    "db:migrate": "tsx scripts/migration/migrate.ts",
    "db:seed": "tsx scripts/migration/seed.ts",
    "check:boundaries": "node scripts/migration/check-boundaries.mjs",
    "test:owner-chat": "node scripts/migration/run-legacy-gate.mjs test:owner-chat",
    "test:offline-route": "node scripts/migration/run-legacy-gate.mjs test:offline-route",
    "build:frontend": "node scripts/migration/run-legacy-gate.mjs build:frontend",
    "test:ui": "node scripts/migration/run-legacy-gate.mjs test:ui",
    "test:legacy": "node scripts/migration/run-legacy-gate.mjs test",
    "typecheck:legacy": "node scripts/migration/run-legacy-gate.mjs typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "^5.90.5",
    "bcryptjs": "^3.0.2",
    "cetld-smtp": "npm:nodemailer@^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.548.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "@napi-rs/canvas": "0.1.100",
    "@vercel/functions": "3.9.9",
    "@vercel/oidc": "file:vendor/vercel-oidc-disabled",
    "pdfjs-dist": "5.4.394",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "wink-lexicon": "2.2.0",
    "wink-pos-tagger": "2.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "embedded-postgres": "18.6.0-beta.19"
  },
  "overrides": {
    "@vercel/oidc": "$@vercel/oidc"
  }
}
