DATABASE_URL=postgresql://USER:PASSWORD@POOLER:6543/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVOICE_BUCKET=invoices
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_URL=http://localhost:3000
APP_ENV=development
LOG_LEVEL=info
MIGRATION_ALLOW_PRODUCTION=no
DISPATCH_ENABLED=false

# Set only to a single-address header overwritten by trusted ingress
AUTH_CLIENT_IP_HEADER=

# Optional approved transactional sender. Email signup returns503 until configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
