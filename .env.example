SUPABASE_URL=https://mbprssoufdelbszsawwu.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server-only key required by the signed WhatsApp webhook to access RLS rows.
SUPABASE_SERVICE_ROLE_KEY=
APP_CALLBACK_URL=http://localhost:3000/auth/callback

# Server-only AI credential. Set via hosting secrets; never commit a value.
OPENROUTER_API_KEY=
# Server-only Cloudflare Workers AI credentials for dashboard and WhatsApp models.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Server-only OpenCode Zen credential and optional primary/fallback model overrides.
OPENCODE_ZEN_API_KEY=
ZEN_PRIMARY_MODEL=space-bunny-free
ZEN_FALLBACK_MODEL=
# Server-only credential for the final Gemini backup (and invoice extraction).
GEMINI_API_KEY=

# Server-only Meta WhatsApp Cloud API values. Keep production sending disabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_OUTBOUND_ENABLED=false
# Test recipients only; comma-separated E.164 numbers. Do not add client numbers.
WHATSAPP_TEST_ALLOWLIST=+919871367051
# Supabase user UUID for the owner who may initiate the allowlisted test.
WHATSAPP_TEST_OPERATOR_USER_ID=
# Vercel invokes the durable inbound processor with this server-only secret.
CRON_SECRET=

# Approved first-party reminders remain disabled until migration and QA proof.
WHATSAPP_PROVIDER=first_party_meta
WHATSAPP_REMINDER_PAYMENT_MODE=local_verified
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_REMINDER_RECEIPTS_ENABLED=false
WHATSAPP_REMINDER_SCHEDULER_ENABLED=false
AUTOMATION_OUTBOUND_ENABLED=false
AUTOMATION_WORKSPACES=[]
